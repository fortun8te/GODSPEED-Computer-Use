+def decision_media(body):
+    """Absent or unusable optional media keeps the original text-only request."""
+    encoded = body.get("image_base64")
+    if not isinstance(encoded, str) or not 0 < len(encoded) <= MAX_PICTURE_BASE64:
+        return {}
+    from PIL import Image
+
+    try:
+        with Image.open(io.BytesIO(base64.b64decode(encoded, validate=True)), formats=["JPEG", "PNG"]) as image:
+            if not 0 < min(image.size) <= max(image.size) <= MAX_PICTURE_SIDE:
+                return {}
+            return {"media": [image.convert("RGB")]}
+    except (OSError, ValueError, Image.DecompressionBombError):
+        return {}
+
